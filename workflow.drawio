<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" type="device">
  <diagram id="config-mgmt-workflow" name="Config Management Workflow">
    <mxGraphModel dx="1760" dy="1320" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="1320" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;&lt;font size=&quot;20&quot;&gt;Config Management Workflow&lt;/font&gt;&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="900" height="36" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Governed input &amp;#8594; Ansible automation &amp;#8594; drift comparison &amp;#8594; remediation loop" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="40" y="62" width="1100" height="26" as="geometry" />
        </mxCell>
        <mxCell id="s01" value="&lt;font color=&quot;#2563eb&quot;&gt;&lt;b&gt;01&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Document Governance Process&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;11&quot; color=&quot;#475569&quot;&gt;Governed input. Approves and maintains configuration intent; annual baseline review and new-baseline intake.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontColor=#0f172a;fillColor=#ffffff;strokeColor=#2563eb;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="270" height="145" as="geometry" />
        </mxCell>
        <mxCell id="s02" value="&lt;font color=&quot;#2563eb&quot;&gt;&lt;b&gt;02&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Security &amp;amp; Operational Baselines&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;11&quot; color=&quot;#475569&quot;&gt;One merged baseline per platform &amp;#8212; YAML on GitHub, PR-approved. Each entry: expected value, comparison operator, severity, SLA.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontColor=#0f172a;fillColor=#ffffff;strokeColor=#2563eb;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="350" y="110" width="270" height="145" as="geometry" />
        </mxCell>
        <mxCell id="gen" value="&lt;font color=&quot;#334155&quot;&gt;&lt;b&gt;04 &amp;#183; AI-AUGMENTED PLAYBOOK GENERATION&lt;/b&gt;&lt;/font&gt;&lt;font size=&quot;11&quot; color=&quot;#475569&quot;&gt; &amp;#8212; per platform, generated once from the baseline&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;verticalAlign=top;spacingTop=10;fontFamily=Helvetica;fontSize=12;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=1.5;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="660" y="110" width="660" height="170" as="geometry" />
        </mxCell>
        <mxCell id="p4a" value="&lt;font color=&quot;#a16207&quot; size=&quot;11&quot;&gt;&lt;b&gt;4A &amp;#183; ANSIBLE &amp;#183; SCAN&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Config Scan Playbook&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;11&quot; color=&quot;#475569&quot;&gt;Read-only collection of actual values. Changes nothing, judges nothing. Bring-your-playbook option. Onboarded into AAP once, human-in-the-loop.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontColor=#0f172a;fillColor=#fef9c3;strokeColor=#ca8a04;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="685" y="155" width="290" height="105" as="geometry" />
        </mxCell>
        <mxCell id="p4b" value="&lt;font color=&quot;#2563eb&quot; size=&quot;11&quot;&gt;&lt;b&gt;4B &amp;#183; PARAMETERIZED &amp;#183; PER PLATFORM&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Config Remediation Playbook&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;11&quot; color=&quot;#475569&quot;&gt;Takes asset, drifted setting and expected value as parameters; returns only that setting to its expected value.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontColor=#0f172a;fillColor=#ffffff;strokeColor=#2563eb;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1020" y="155" width="275" height="105" as="geometry" />
        </mxCell>
        <mxCell id="s05" value="&lt;font color=&quot;#2563eb&quot;&gt;&lt;b&gt;05&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Scan execution&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;11&quot; color=&quot;#475569&quot;&gt;e.g. daily at 5 AM &amp;#8212; governed cadence, scope and window.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontColor=#0f172a;fillColor=#ffffff;strokeColor=#2563eb;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="360" width="270" height="145" as="geometry" />
        </mxCell>
        <mxCell id="s06" value="&lt;font color=&quot;#2563eb&quot;&gt;&lt;b&gt;06&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Ansible Automation Platform&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;11&quot; color=&quot;#475569&quot;&gt;Execution plane. Runs only the approved playbook version, against the authorized scope and window.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontColor=#0f172a;fillColor=#ffffff;strokeColor=#2563eb;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="350" y="360" width="270" height="145" as="geometry" />
        </mxCell>
        <mxCell id="s07" value="&lt;font color=&quot;#2563eb&quot;&gt;&lt;b&gt;07&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Assets&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;11&quot; color=&quot;#475569&quot;&gt;Target scope. Actual state is scanned here; governed configuration is applied here.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontColor=#0f172a;fillColor=#ffffff;strokeColor=#2563eb;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="660" y="360" width="290" height="145" as="geometry" />
        </mxCell>
        <mxCell id="s08" value="&lt;font color=&quot;#2563eb&quot;&gt;&lt;b&gt;08&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Data Store &amp;#8212; ClickHouse&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;11&quot; color=&quot;#475569&quot;&gt;Expected vs actuals. Drift is evaluated here as a join, stamped with the baseline commit SHA.&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fontFamily=Helvetica;fontSize=13;fontColor=#0f172a;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1010" y="360" width="290" height="145" as="geometry" />
        </mxCell>
        <mxCell id="s09" value="&lt;font color=&quot;#2563eb&quot;&gt;&lt;b&gt;09&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;KPIs / Tracking / Governance&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;11&quot; color=&quot;#475569&quot;&gt;Evidence side: compliance rate, open drift, aging and SLA, MTTR, auto-remediation rate, scan coverage, exception register.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontColor=#0f172a;fillColor=#ffffff;strokeColor=#2563eb;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1010" y="640" width="290" height="145" as="geometry" />
        </mxCell>
        <mxCell id="note_archer" value="&lt;i&gt;If drift is detected, the remediation playbook kicks off &amp;#8212; unless an Archer finding is in place.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontFamily=Helvetica;fontSize=12;fillColor=#fffbeb;strokeColor=#d97706;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="925" y="818" width="460" height="58" as="geometry" />
        </mxCell>
        <mxCell id="p4b_inv" value="&lt;font color=&quot;#2563eb&quot; size=&quot;11&quot;&gt;&lt;b&gt;4B &amp;#183; INVOCATION&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Config Remediation Playbook&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;11&quot; color=&quot;#475569&quot;&gt;Same playbook generated at 04 &amp;#8212; invoked through AAP with asset, drifted setting + expected value.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontColor=#0f172a;fillColor=#ffffff;strokeColor=#2563eb;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1010" y="910" width="290" height="145" as="geometry" />
        </mxCell>
        <mxCell id="loop_steps" value="&lt;b&gt;REMEDIATION LOOP &amp;#8212; 09 &amp;#8594; 4B &amp;#8594; 07&lt;/b&gt; &amp;nbsp;&lt;font color=&quot;#475569&quot;&gt;Temporal workflow, one instance per drift item: &amp;nbsp;1) Notify the app custodian (always). &amp;nbsp;2) Archer check &amp;#8212; excepted drift stays tracked at 09. &amp;nbsp;3) Auto-remediate through AAP with parameters. &amp;nbsp;4) Rescan with the 4A scan playbook to verify. &amp;nbsp;5) Close only when the rescan shows the expected value; otherwise the item stays open. No per-drift approval gate &amp;#8212; human-in-the-loop sits at playbook onboarding into AAP.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;fontFamily=Helvetica;fontSize=12;fillColor=#fffbeb;strokeColor=#d97706;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="40" y="1100" width="1260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="&lt;font color=&quot;#475569&quot;&gt;&lt;b&gt;Terms:&lt;/b&gt; Governed input = governed documents and baselines feeding the flow &amp;#183; Ansible automation = execution through Ansible playbooks and AAP &amp;#183; AI-augmented = AI-assisted generation at 04 &amp;#183; Bring your playbook = an existing platform-owned playbook brought into the governed cycle (yellow 4A) &amp;#183; Remediation loop = the 09 &amp;#8594; 4B &amp;#8594; 07 drift-response route &amp;#183; Evidence = evaluation output at 09, not the Data Store itself.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="1220" width="1260" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e01_02" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=11;strokeColor=#2563eb;strokeWidth=2;endArrow=classic;" edge="1" parent="1" source="s01" target="s02">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
