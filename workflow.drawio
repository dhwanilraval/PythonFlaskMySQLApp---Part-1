          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_gen_05" value="Generated scan playbook runs on cadence" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=11;strokeColor=#2563eb;strokeWidth=2;endArrow=classic;" edge="1" parent="1" source="gen" target="s05">
