          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="830" y="320" />
              <mxPoint x="1155" y="320" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e05_06" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=11;strokeColor=#2563eb;strokeWidth=2;endArrow=classic;" edge="1" parent="1" source="s05" target="s06">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e06_07" value="Executes against assets" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=11;strokeColor=#2563eb;strokeWidth=2;endArrow=classic;" edge="1" parent="1" source="s06" target="s07">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e02_08" value="Expected state published on merge (baseline commit SHA)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=11;strokeColor=#2563eb;strokeWidth=1.5;dashed=1;endArrow=classic;" edge="1" parent="1" source="s02" target="s08">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="485" y="560" />
              <mxPoint x="1080" y="560" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e08_09" value="Drift records &amp;#8212; expected vs actual" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=11;strokeColor=#2563eb;strokeWidth=2;endArrow=classic;" edge="1" parent="1" source="s08" target="s09">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e09_4b" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=11;strokeColor=#d97706;strokeWidth=2.5;dashed=1;endArrow=classic;" edge="1" parent="1" source="s09" target="p4b_inv">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4b_07" value="Remediation &amp;#8212; runs directly against the drifted asset" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=11;strokeColor=#dc2626;strokeWidth=2.5;dashed=1;endArrow=classic;" edge="1" parent="1" source="p4b_inv" target="s07">
          <mxGeometry relative="1" as="geometry">
